# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/

# Test & coverage
coverage/
playwright-report/
test-results/
.tmp-phase-5-video/

# Environment & secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store

# Local coding-agent state (worktrees, settings, transcripts). CLAUDE.md at the
# root is the committed project instruction file and is not affected.
.claude/

# Logs
*.log

# Regenerated golden-test inputs (ingested corpus docs produced by the CLI
# cut-golden test itself; never committed — see apps/cli/test/cut-golden.test.ts)
fixtures/.cut-inputs/

# Pinned OSS scale-fixture clones (~100k LOC) — fetched outside the tree by
# fixtures/oss/fetch.sh; only the compact summary golden is committed. See
# fixtures/oss/README.md.
fixtures/oss/clones/

# api-extractor scratch
packages/*/temp/

# Per-run benchmark dashboards/logs are CI artifacts. Studio may place its
# browser measurement input in this directory before the collector runs.
benchmarks/results/
