{
  "name": "@meridian/adapter-markdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meridian's first domain adapter: CommonMark documents → nested semantic graphs (sections, blocks, internal links). Deterministic, AI-free, isomorphic. Imports @meridian/plugin-api and the micromark/mdast parser, nothing else of Meridian.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@meridian/plugin-api": "workspace:*",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@meridian/conformance-kit": "workspace:*",
    "@meridian/graph-core": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
