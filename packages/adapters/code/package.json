{
  "name": "@meridian/adapter-code",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Source-code domain adapter (tree-sitter, isomorphic, worker-hosted per ADR-0017). 7B: grammar-loading shim + vendored TS/Python WASM grammars. 7C/7D: TypeScript and Python mapping at eager levels (project→package→module→class/function/method signatures), stable IDs per ADR-0002/0028.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker-host": {
      "types": "./dist/worker-host-entry.d.ts",
      "default": "./dist/worker-host-entry.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime-entry.d.ts",
      "default": "./dist/worker-runtime-entry.js"
    },
    "./grammars/tree-sitter-typescript.wasm": "./grammars/tree-sitter-typescript.wasm",
    "./grammars/tree-sitter-python.wasm": "./grammars/tree-sitter-python.wasm"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@meridian/plugin-api": "workspace:*",
    "comlink": "^4.4.2",
    "web-tree-sitter": "0.26.10"
  },
  "devDependencies": {
    "@meridian/conformance-kit": "workspace:*",
    "@meridian/graph-core": "workspace:*",
    "@meridian/graph-store": "workspace:*",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
