{
  "name": "@meridian/renderer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Pixi-backed presentation adapter with pure camera, spatial-index, and culling machinery.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/fonts/meridian-msdf.fnt",
    "assets/fonts/meridian-msdf.png",
    "assets/fonts/LICENSE-DejaVu.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite harness --host 127.0.0.1",
    "harness:build": "vite build harness",
    "fps:probe": "vite build harness && node tools/fps-probe.mjs",
    "font:regen": "node tools/generate-msdf-font.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@meridian/view-model": "workspace:*",
    "pixi.js": "8.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "msdf-bmfont-xml": "2.7.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.8.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
