{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["UPDATE_GOLDENS", "FC_SEED", "MERIDIAN_MAIN_THREAD_GAP_MS"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
