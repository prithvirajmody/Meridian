{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["UPDATE_GOLDENS", "FC_SEED"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
