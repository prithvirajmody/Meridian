  "digest_sha256": "d4737900f95539c461feb227ba5d953da70b41ba8b6f75de0d1a89a6ace99ec6",
  "gates": [
    {
      "gate_id": "fund_promotion_gate",
      "over": [
        "fund_evidence",
        "fund_promotion_case"
      ],
      "rule": {
        "aggregation": "oracle-v1-required-total-order",
        "checks": [
          {
            "comparison": "gte",
            "id": "win_rate",
            "observation_id": "win_rate",
            "rationale": "Closed trades won, as a fraction of closed trades, over the whole recorded window. Below 0.55 the strategy family does not clear the discipline's own floor and no amount of narrative substitutes.",
            "required": true,
            "threshold": 0.55,
            "unit": "ratio"
          },
          {
            "comparison": "gte",
            "id": "reward_risk",
            "observation_id": "reward_risk",
            "rationale": "Mean winning R divided by mean losing R, both measured against the trade's own initial risk. The expectancy framing this stands in for is E = win_rate x avg_win_R - (1 - win_rate) x avg_loss_R; at win_rate 0.55 and reward_risk 2.0 that expectancy is +0.65R per trade. reward_risk is the required check because it is the term that degrades first when fills are modelled optimistically; expectancy_r is carried as an advisory cross-check so the two cannot silently disagree.",
            "required": true,
            "threshold": 2.0,
            "unit": "r_multiple"
          },
          {
            "comparison": "gte",
            "id": "sample_size",
            "observation_id": "sample_trades",
            "rationale": "Fewer than 100 closed trades cannot separate an edge from a run of luck at these win rates, so a small sample is refused rather than reported with a caveat.",
            "required": true,
            "threshold": 100.0,
            "unit": "trades"
          },
          {
            "comparison": "is_true",
            "id": "multi_year_positive",
            "observation_id": "multi_year_positive",
            "rationale": "Every complete calendar year in the recorded window is net positive in R. One dominant year carrying an otherwise flat record is a regime artefact, not an edge.",
            "required": true,
            "threshold": null,
            "unit": "boolean"
          },
          {
            "comparison": "is_true",
            "id": "outlier_survival",
            "observation_id": "outlier_survival",
            "rationale": "The record stays net positive with the single best trade removed. A result that depends on one fill is a story about that fill.",
            "required": true,
            "threshold": null,
            "unit": "boolean"
          },
          {
            "comparison": "is_true",
            "id": "no_opening_bar_fills",
            "observation_id": "no_opening_bar_fills",
            "rationale": "No modelled entry or exit is filled on the session's opening bar. This check encodes a fill-realism bug that was actually shipped: opening-bar fills are unobtainable at the modelled price and flattered a prior version of this family. It is here because it already went wrong once.",
            "required": true,
            "threshold": null,
            "unit": "boolean"
          },
          {
            "comparison": "is_true",
            "id": "reproducible_from_committed_script",
            "observation_id": "reproducible_from_committed_script",
            "rationale": "Re-running the pinned committed script reproduces the exported figures. This check encodes a published figure that could not be reproduced from the code that supposedly generated it; an unreproducible number is not evidence, whatever it says.",
            "required": true,
            "threshold": null,
            "unit": "boolean"
          },
          {
            "comparison": "gte",
            "id": "expectancy_positive",
            "observation_id": "expectancy_r",
            "rationale": "Advisory cross-check on the documented expectancy framing above. Non-required because it is arithmetically implied by the win_rate and reward_risk checks; it is reported so a disagreement between the three is visible rather than assumed impossible.",
            "required": false,
            "threshold": 0.0,
            "unit": "r_multiple"
          },
          {
            "comparison": "is_true",
            "id": "analyst_citation_fidelity",
            "observation_id": "analyst_claims_match_evidence",
            "rationale": "Every value the analyst quoted matches the frozen evidence. Non-required by design: the analyst has no authority over this gate, so misquoting the data must be visible without being able to change the verdict either way.",
            "required": false,
            "threshold": null,
            "unit": "boolean"
          }
        ],
        "gate_version": "1.0.0"
      }
    }
  ],
